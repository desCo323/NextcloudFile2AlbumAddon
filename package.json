{
  "name": "sakuraalbum",
  "version": "1.0.12",
  "private": true,
  "description": "Nextcloud app for managed Photos albums from folders.",
  "scripts": {
    "check": "bash scripts/self-check.sh",
    "build:artifact": "bash scripts/build-artifact.sh",
    "test:browser": "playwright test",
    "test:browser:auth": "SAKURAALBUM_AUTH_TESTS=1 playwright test tests/Browser/authenticated-settings.auth.spec.js",
    "test:browser:journey": "SAKURAALBUM_AUTH_TESTS=1 playwright test tests/Browser/user-journey.auth.spec.js",
    "test:browser:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
